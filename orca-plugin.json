{
  "manifestVersion": 1,
  "id": "orca-jev-advisor",
  "publisher": "ab2web",
  "name": "Jev Advisor",
  "version": "0.13.10",
  "description": "Jev (TypeSafe)-backed decision layer for judging proposed actions and keeping a status board across Orca worktrees.",
  "author": {
    "name": "Ab2Web"
  },
  "repository": "https://github.com/ab2webco/orca-jev-advisor",
  "icon": "adapters/orca/icons/advisor.svg",
  "engines": {
    "orca": ">=1.4.0"
  },
  "pluginApi": 1,
  "main": "adapters/orca/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "advisor-board",
        "title": "Advisor",
        "icon": "adapters/orca/icons/advisor.svg",
        "entry": "adapters/orca/panels/board.html",
        "surface": "nav"
      },
      {
        "id": "advisor-config",
        "title": "Jev Advisor",
        "icon": "adapters/orca/icons/advisor.svg",
        "entry": "adapters/orca/panels/config.html",
        "surface": "settings"
      }
    ],
    "commands": [
      {
        "id": "advisor.decide",
        "title": "Advisor: Judge proposed action(s)"
      },
      {
        "id": "advisor.board",
        "title": "Advisor: View cross-worktree board"
      },
      {
        "id": "advisor.doctor",
        "title": "Advisor: Check configuration"
      },
      {
        "id": "advisor.installClaude",
        "title": "Advisor: Install the Claude Code side"
      },
      {
        "id": "advisor.uninstallClaude",
        "title": "Advisor: Revert the Claude Code side"
      },
      {
        "id": "advisor.installCodex",
        "title": "Advisor: Install the Codex side"
      },
      {
        "id": "advisor.uninstallCodex",
        "title": "Advisor: Revert the Codex side"
      },
      {
        "id": "advisor.refreshCatalog",
        "title": "Advisor: Add newly seen worktrees to the catalog"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "worktree.created"
      },
      {
        "on": "worktree.removed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage"
    },
    {
      "kind": "secrets"
    },
    {
      "kind": "events:subscribe"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
